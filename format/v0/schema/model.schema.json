{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:erdmaker:format:0.1:model",
  "title": "Model manifest (model.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "id",
    "name"
  ],
  "properties": {
    "formatVersion": {
      "const": "0.1"
    },
    "id": {
      "$ref": "urn:erdmaker:format:0.1:common#/$defs/id"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "definition": {
      "type": "string"
    },
    "notation": {
      "enum": [
        "ie",
        "idef1x"
      ],
      "default": "ie"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dbms"
        ],
        "properties": {
          "dbms": {
            "$ref": "urn:erdmaker:format:0.1:common#/$defs/dbms"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "minItems": 1,
      "description": "Target DBMS list. The first entry is the default for DDL generation."
    },
    "dictionaries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": [
        "dictionary"
      ],
      "description": "Dictionary directories, relative to model.yaml, searched in order."
    },
    "ext": {
      "$ref": "urn:erdmaker:format:0.1:common#/$defs/ext"
    }
  }
}
